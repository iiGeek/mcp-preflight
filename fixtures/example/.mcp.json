{
  "mcpServers": {
    "notes": {
      "command": "npx",
      "args": ["-y", "@example/notes-mcp@1.4.2"],
      "env": {
        "NOTES_TOKEN": "${NOTES_TOKEN}"
      }
    },
    "files": {
      "command": "npx",
      "args": ["-y", "@modelcontextprotocol/server-filesystem@2025.1.0", "/"],
      "env": {
        "API_KEY": "sk-test-abcdefghijklmnopqrstuvwxyz"
      }
    },
    "search": {
      "command": "npx",
      "args": ["-y", "mcp-server-search"]
    },
    "intranet": {
      "type": "http",
      "url": "http://intranet.example.com/mcp",
      "headers": {
        "Authorization": "Bearer ${INTRANET_TOKEN}"
      }
    },
    "local-preview": {
      "type": "http",
      "url": "http://127.0.0.1:3000/mcp"
    }
  }
}
